								</valItem>
								<valItem mode="change" ident="M">
									<desc versionDate="2024-09-30" xml:lang="en">this is a medial
										part of a fragmented element if there are three fragments,
										or the second fragment if there are four fragments</desc>
								</valItem>
								<valItem mode="change" ident="F">
									<desc versionDate="2024-09-30" xml:lang="en">this is the final
										part of a fragmented element if there are two or three
										fragments, or the second to last part if there are four
										fragments</desc>
								</valItem>
								<valItem mode="add" ident="F2">
									<desc versionDate="2024-09-30" xml:lang="en">only used if there
										are four fragments, in that case this is the final part of
										the fragmented element</desc>
								</valItem>
								<valItem mode="change" ident="N">
									<desc versionDate="2024-09-30" xml:lang="en">the element is not
										fragmented, or no claim is made as to its completeness; this
										option is equivalent to not having the part-attribute on the
										element</desc>
								</valItem>
								<valItem mode="delete" ident="Y"/>
							</valList>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.global" type="atts" mode="change">
					<attList>
						<attDef ident="xml:lang" mode="change">
							<valList type="semi" mode="change">
								<valItem mode="add" ident="sv">
									<desc versionDate="2024-09-30" xml:lang="en">Swedish</desc>
								</valItem>
								<valItem mode="add" ident="fi">
									<desc versionDate="2024-09-30" xml:lang="en">Finnish</desc>
								</valItem>
								<valItem mode="add" ident="en">
									<desc versionDate="2024-09-30" xml:lang="en">English</desc>
								</valItem>
								<valItem mode="add" ident="fr">
									<desc versionDate="2024-09-30" xml:lang="en">French</desc>
								</valItem>
								<valItem mode="add" ident="de">
									<desc versionDate="2024-09-30" xml:lang="en">German</desc>
								</valItem>
							</valList>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.global.facs" type="atts" mode="change">
					<attList>
						<attDef ident="facs" mode="change">
							<desc versionDate="2024-09-30" xml:lang="en">filename of image depicting
								the current page.</desc>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.global.rendition" type="atts" mode="change">
					<attList>
						<attDef ident="rend" mode="change">
							<valList type="closed" mode="change"/>
						</attDef>
						<attDef ident="style" mode="delete"/>
						<attDef ident="rendition" mode="delete"/>
					</attList>
				</classSpec>
				<classSpec ident="att.global.responsibility" type="atts" mode="change">
					<attList>
						<attDef ident="cert" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="low"/>
							</valList>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.handFeatures" type="atts" mode="change">
					<attList>
						<attDef ident="medium" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="black-ink"/>
								<valItem mode="add" ident="black-inkOther"/>
								<valItem mode="add" ident="black-pen"/>
								<valItem mode="add" ident="blue-ink"/>
								<valItem mode="add" ident="blue-pen"/>
								<valItem mode="add" ident="blue-pencil"/>
								<valItem mode="add" ident="brown-ink"/>
								<valItem mode="add" ident="brown-inkOther"/>
								<valItem mode="add" ident="green-ink"/>
								<valItem mode="add" ident="green-pen"/>
								<valItem mode="add" ident="green-pencil"/>
								<valItem mode="add" ident="indeliblePencil"/>
								<valItem mode="add" ident="pencil"/>
								<valItem mode="add" ident="red-ink"/>
								<valItem mode="add" ident="red-pencil"/>
								<valItem mode="add" ident="violet-ink"/>
								<valItem mode="add" ident="print"/>
								<valItem mode="add" ident="stamp"/>
								<valItem mode="add" ident="typescript"/>
							</valList>
						</attDef>
						<attDef ident="scribe" mode="delete"/>
						<attDef ident="scribeRef" mode="delete"/>
						<attDef ident="script" mode="delete"/>
						<attDef ident="scriptRef" mode="delete"/>
						<attDef ident="scope" mode="delete"/>
					</attList>
				</classSpec>
				<classSpec ident="att.media" type="atts" mode="change">
					<attList>
						<attDef ident="scale" mode="delete"/>
					</attList>
				</classSpec>
				<classSpec ident="att.milestoneUnit" type="atts" mode="change">
					<attList>
						<attDef ident="unit" mode="change" usage="opt">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="part"/>
								<valItem mode="delete" ident="page"/>
								<valItem mode="delete" ident="column"/>
								<valItem mode="delete" ident="line"/>
								<valItem mode="delete" ident="book"/>
								<valItem mode="delete" ident="poem"/>
								<valItem mode="delete" ident="canto"/>
								<valItem mode="delete" ident="speaker"/>
								<valItem mode="delete" ident="stanza"/>
								<valItem mode="delete" ident="act"/>
								<valItem mode="delete" ident="scene"/>
								<valItem mode="delete" ident="section"/>
								<valItem mode="delete" ident="absent"/>
								<valItem mode="delete" ident="unnumbered"/>
							</valList>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.naming" type="atts" mode="change">
					<attList>
						<attDef ident="role" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="fictional"/>
							</valList>
						</attDef>
						<attDef ident="nymRef" mode="delete"/>
					</attList>
				</classSpec>
				<classSpec ident="att.placement" type="atts" mode="change">
					<attList>
						<attDef ident="place" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="delete" ident="above"/>
								<valItem mode="delete" ident="below"/>
								<valItem mode="delete" ident="bottom"/>
								<valItem mode="delete" ident="end"/>
								<valItem mode="delete" ident="inline"/>
								<valItem mode="delete" ident="inspace"/>
								<valItem mode="delete" ident="left"/>
								<valItem mode="delete" ident="margin"/>
								<valItem mode="delete" ident="opposite"/>
								<valItem mode="delete" ident="overleaf"/>
								<valItem mode="delete" ident="right"/>
								<valItem mode="delete" ident="top"/>
							</valList>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.pointing" type="atts" mode="change">
					<attList>
						<attDef ident="targetLang" mode="delete"/>
						<attDef ident="evaluate" mode="delete"/>
					</attList>
				</classSpec>
				<classSpec ident="att.segLike" type="atts" mode="change">
					<attList>
						<attDef ident="function" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="addForHyphenation">
									<desc versionDate="2024-09-30" xml:lang="en">add the
										character(s) if the word is hyphenated</desc>
								</valItem>
								<valItem mode="add" ident="removeForHyphenation">
									<desc versionDate="2024-09-30" xml:lang="en">remove the
										character(s) if the word is hyphenated</desc>
								</valItem>
							</valList>
						</attDef>
					</attList>
				</classSpec>

				<classSpec ident="att.textCritical" type="atts" mode="change">
					<attList>
						<attDef ident="type" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="empty"/>
								<valItem mode="delete" ident="substantive"/>
								<valItem mode="delete" ident="orthographic"/>
							</valList>
						</attDef>
						<attDef ident="cause" mode="delete"/>
						<attDef ident="varSeq" mode="delete"/>
						<attDef ident="require" mode="delete"/>
					</attList>
				</classSpec>
				<classSpec ident="att.typed" type="atts" mode="change">
					<attList>
						<attDef ident="type" mode="change">
							<valList type="closed" mode="change"/>
						</attDef>
						<attDef ident="subtype" mode="change">
							<valList type="closed" mode="change"/>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.witnessed" type="atts" mode="change">
					<attList>
						<attDef ident="wit" mode="change">
							<desc versionDate="2024-09-30" xml:lang="en">contains the names of the
								witnesses which attest to a given reading.</desc>
						</attDef>
					</attList>
				</classSpec>
			</schemaSpec>
		</body>
	</text>
</TEI>