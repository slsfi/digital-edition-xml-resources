<TEI xmlns="http://www.tei-c.org/ns/1.0">
	<teiHeader>
		<fileDesc>
			<titleStmt>
				<title>TEI SLS master schema</title>
				<author xml:id="SK">Sebastian Köhler</author>
			</titleStmt>
			<publicationStmt>
				<publisher xml:lang="sv">Svenska litteratursällskapet i Finland</publisher>
				<publisher xml:lang="en">Society of Swedish Literature in Finland</publisher>
				<ref target="https://www.sls.fi/">https://www.sls.fi/</ref>
				<availability status="free">
					<licence target="https://creativecommons.org/licenses/by-sa/4.0/">
						Distributed under a Creative Commons Attribution-ShareAlike
						4.0 International License
					</licence>
				</availability>
			</publicationStmt>
			<sourceDesc>
				<p>TEI Minimal.</p>
			</sourceDesc>
		</fileDesc>
		<revisionDesc>
			<change when="2026-06-10" who="#SK">
				- Add "custom-marker" and "custom-number" to values of @rend on list.
			</change>
			<change when="2026-06-09" who="#SK">
				- Add correction, editorialDecl, hyphenation, interpretation, projectDesc,
				  punctuation, and quotation.
				- Add @n on item and witness.
			</change>
			<change when="2026-06-01" who="#SK">
				- Add @key with distinct values on resp.
				- Add @xml:id on bibl.
				- Add @source on milestone.
				- Add listWit and witness.
				- Add @xml:id on msIdentifier.
				- Add @who on change.
			</change>
			<change when="2026-05-26" who="#SK">
				- Change the default Roma-generated licence to CC BY-SA 4.0.
				- Add @xml:lang on availability and licence.
				- Add @type and @subtype on ab, and @type on date.
				- Add @xml:id, @from, @ref, @to, and @when on name.
				- Add @xml:lang, @from, @to, and @when on resp.
				- Add @xml:lang and @extent on dimensions.
				- Add @xml:lang on msDesc.
				- Add biblScope.
			</change>
			<change when="2026-04-15" who="#SK"> 
				- Add extent, dimensions, height, history, objectDesc, origin, physDesc,
				  supportDesc, and width.
				- Modify @unit in att.dimensions and define @unit explicitly on the elements that
				  include it.
				- Fix the list of revisions to the ODD.
				- Add @from, @to, @notAfter, and @notBefore on origDate, and @notAfter and
				  @notBefore on date.
				- Remove @source and @type from milestone. Add @ed, @n, @rend, and @xml:id to
				  milestone. Modify values of @unit on milestone and make it required.
				- Fix declaration of @type values on correspAction.
			</change>
			<change when="2026-04-14" who="#SK"> 
				- Add "illegible" to values of @reason on gap, and "margin" to values of @place
				  on note.
				- Support TEI <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/readme-4.11.0.html">P5
				  version 4.11.0</ref>.
			</change>
			<change when="2025-09-10" who="#SK"> 
				- Add @hand on head and text.
				- Remove "pre-print" from values of @medium.
			</change>
			<change when="2025-08-28" who="#SK"> 
				- Add @hand on p and seg.
				- Remove @rend from seg.
				- Remove "typewrite" from values of @medium. Add "pre-print", "print", "stamp", and
				  "typescript" to values of @medium.
			</change>
			<change when="2025-08-26" who="#SK"> 
				- Add "smaller" to values of @rend on q.
			</change>
			<change when="2025-06-24" who="#SK"> 
				- Add "black-pen" to values of @medium.
			</change>
			<change when="2025-05-07" who="#SK"> 
				- Add "main" to values of @type on title.
			</change>
			<change when="2025-05-05" who="#SK"> 
				- Remove @hand from head.
			</change>
			<change when="2025-04-23" who="#SK"> 
				- Add @rend="strikethrough" on delSpan.
			</change>
			<change when="2025-03-13" who="#SK"> 
				- Add "host" to values of @type on title.
			</change>
			<change when="2025-03-11" who="#SK"> 
				- Add @cert and @role to rs.
				- Mark @unit and @quantity as optional on space.
			</change>
			<change when="2025-02-25" who="#SK"> 
				- Add @xml:lang on note; @xml:id on cell, item, l, lg, p, row, and seg; @n on metamark;
				  @function="transp" on metamark, listTranspose, and transpose.
				- Update values of @rend on byline and dateline.
			</change>
			<change when="2025-02-22" who="#SK"> 
				- Remove @xml:space="preserve" requirement from body.
			</change>
			<change when="2025-02-11" who="#SK"> 
				- Remove requirement of @n, @place, and @xml:id on note.
			</change>
			<change when="2025-02-05" who="#SK"> 
				- Add msDesc and child elements (msIdentifier and related).
			</change>
			<change when="2025-02-04" who="#SK"> 
				- Support TEI <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/readme-4.9.0.html">P5
				  version 4.9.0</ref>.
			</change>
			<change when="2025-01-22" who="#SK"> 
				- Add "move" to values of `@type` on add and addSpan.
			</change>
			<change when="2025-01-21" who="#SK"> 
				- Make attributes of gap and unclear optional.
			</change>
			<change when="2025-01-15" who="#SK"> 
				- Modify values of @type on idno.
				- Add textClass and related child elements.
				- Add xenoData.
			</change>
			<change when="2025-01-09" who="#SK"> 
				- Add @n on lg.
			</change>
			<change when="2024-12-12" who="#SK"> 
				- Add "smallCaps" to values of @rend.
			</change>
			<change when="2024-12-09" who="#SK"> 
				- Initial commit.
				- Fix @type values on correspAction.
			</change>
		</revisionDesc>
	</teiHeader>
	<text>
		<body>
			<head>Master TEI Customization of the Society of Swedish Literature in Finland
				(SLS)</head>

			<p>This TEI ODD defines a TEI customization that is used as the master TEI customization
				for TEI-encoded text by the Society of Swedish Literature in Finland (<ref
					target="https://www.sls.fi/">SLS</ref>). This customization can be further
				customized for different text types or editions. The ODD was originally created in
				October–December 2024, first with RomaJS 1.1.1, then by manual editing to fix
				problems that RomaJS caused.</p>

			<schemaSpec ident="tei_sls_master" start="TEI" prefix="tei_" targetLang="en" docLang="en">

				<!-- required minimal header elements -->
				<moduleRef key="header" include="availability change correspAction correction
					correspDesc editorialDecl encodingDesc extent fileDesc handNote hyphenation idno
					interpretation keywords licence normalization notesStmt publicationStmt
					profileDesc projectDesc punctuation quotation revisionDesc seriesStmt sourceDesc
					teiHeader textClass titleStmt xenoData"/>

				<!-- required core elements (p and title for use in titleStmt) -->
				<moduleRef key="core" include="abbr add address addrLine author bibl biblScope
					choice cit corr date del expan foreign gap graphic head hi item l label lb lg
					list milestone name note orig p pb ptr publisher pubPlace q quote ref reg resp
					respStmt rs term title unclear"/>

				<!-- required textstructure elements (TEI, text, and body) -->
				<moduleRef key="textstructure" include="argument body byline closer dateline div
					epigraph floatingText opener postscript salute signed TEI text"/>

				<!-- required module tei instantiates lots of classes used for further expansion
					 of this odd -->
				<moduleRef key="tei"/>

				<moduleRef key="linking" include="ab anchor seg"/>
				<moduleRef key="transcr" include="addSpan delSpan handNotes handShift listTranspose
					metamark restore space subst supplied transpose"/>
				<moduleRef key="textcrit" include="app lem listWit rdg witness"/>
				<moduleRef key="analysis" include="c pc"/>
				<moduleRef key="figures" include="cell figDesc figure row table"/>
				<moduleRef key="msdescription" include="collection dimensions height history
					institution msDesc msIdentifier msName objectDesc origDate origin physDesc
					repository supportDesc width"/>
				<moduleRef key="namesdates" include="country persName placeName region settlement"/>

				<elementSpec ident="ab" mode="change">
					<classes mode="change">
						<memberOf key="att.fragmentable" mode="delete"/>
						<memberOf key="att.written" mode="delete"/>
					</classes>
					<attList>
						<attDef ident="xml:id" mode="delete"/>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
						<attDef ident="rend" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="bold"/>
								<valItem mode="add" ident="encircled"/>
								<valItem mode="add" ident="expanded"/>
								<valItem mode="add" ident="italics"/>
								<valItem mode="add" ident="larger"/>
								<valItem mode="add" ident="raised"/>
								<valItem mode="add" ident="smallCaps"/>
								<valItem mode="add" ident="smaller"/>
								<valItem mode="add" ident="strikethrough"/>
								<valItem mode="add" ident="subscript"/>
								<valItem mode="add" ident="superscript"/>
								<valItem mode="add" ident="underline"/>
								<valItem mode="add" ident="underlineDashed"/>
								<valItem mode="add" ident="underlineDouble"/>
								<valItem mode="add" ident="uppercase"/>
							</valList>
						</attDef>
						<attDef ident="type" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="licence"/>
								<valItem mode="add" ident="rights"/>
							</valList>
						</attDef>
						<attDef ident="subtype" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="sourceWork"/>
								<valItem mode="add" ident="teiEncoding"/>
							</valList>
						</attDef>
					</attList>
				</elementSpec>
				<elementSpec ident="abbr" mode="change">
					<classes mode="change">
						<memberOf key="att.typed" mode="delete"/>
					</classes>
					<attList>
						<attDef ident="xml:id" mode="delete"/>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:lang" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="rend" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
					</attList>
				</elementSpec>
				<elementSpec ident="add" mode="change">
					<classes mode="change">
						<memberOf key="att.dimensions" mode="delete"/>
						<memberOf key="att.written"/>
						<memberOf key="att.placement"/>
					</classes>
					<attList>
						<attDef ident="xml:id" mode="delete"/>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:lang" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="rend" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
						<attDef ident="subtype" mode="delete"/>
						<attDef ident="place" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="botMargin"/>
								<valItem mode="add" ident="leftMargin"/>
								<valItem mode="add" ident="rightMargin"/>
								<valItem mode="add" ident="topMargin"/>
								<valItem mode="add" ident="inline"/>
								<valItem mode="add" ident="sublinear"/>
								<valItem mode="add" ident="other"/>
								<valItem mode="add" ident="nextPage"/>
								<valItem mode="add" ident="previousPage"/>
							</valList>
						</attDef>
						<attDef ident="type" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="choice"/>
								<valItem mode="add" ident="move"/>
								<valItem mode="add" ident="noAnchor"/>
							</valList>
						</attDef>
					</attList>
				</elementSpec>
				<elementSpec ident="addSpan" mode="change">
					<classes mode="change">
						<memberOf key="att.dimensions" mode="delete"/>
						<memberOf key="att.written"/>
						<memberOf key="att.placement"/>
					</classes>
					<attList>
						<attDef ident="xml:id" mode="delete"/>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:lang" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="rend" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
						<attDef ident="subtype" mode="delete"/>
						<attDef ident="place" mode="change" usage="req">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="botMargin"/>
								<valItem mode="add" ident="leftMargin"/>
								<valItem mode="add" ident="rightMargin"/>
								<valItem mode="add" ident="topMargin"/>
								<valItem mode="add" ident="other"/>
								<valItem mode="add" ident="nextPage"/>
								<valItem mode="add" ident="previousPage"/>
							</valList>
						</attDef>
						<attDef ident="spanTo" mode="change" usage="req"/>
						<attDef ident="type" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="move"/>
								<valItem mode="add" ident="noAnchor"/>
							</valList>
						</attDef>
					</attList>
				</elementSpec>
				<elementSpec ident="addrLine" mode="change">
					<attList>
						<attDef ident="xml:id" mode="delete"/>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:lang" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="rend" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
					</attList>
				</elementSpec>
				<elementSpec ident="address" mode="change">
					<classes mode="change">
						<memberOf key="att.canonical" mode="delete"/>
						<memberOf key="att.typed" mode="delete"/>
					</classes>
					<attList>
						<attDef ident="xml:id" mode="delete"/>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:lang" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="rend" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
						<attDef ident="type" mode="delete"/>
						<attDef ident="role" mode="delete"/>
					</attList>
				</elementSpec>
				<elementSpec ident="anchor" mode="change">
					<attList>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:lang" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="rend" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
						<attDef ident="subtype" mode="delete"/>
						<attDef ident="type" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="xref"/>
							</valList>
						</attDef>
					</attList>
				</elementSpec>
				<elementSpec ident="app" mode="change">
					<classes mode="change">
						<memberOf key="att.typed" mode="delete"/>
					</classes>
					<attList>
						<attDef ident="xml:id" mode="delete"/>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:lang" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="rend" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
						<attDef ident="type" mode="delete"/>
						<attDef ident="from" mode="delete"/>
						<attDef ident="to" mode="delete"/>
						<attDef ident="loc" mode="delete"/>
					</attList>
				</elementSpec>
				<elementSpec ident="argument" mode="change">
					<attList>
						<attDef ident="source" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="rend" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="xml:id" mode="delete"/>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:lang" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
					</attList>
				</elementSpec>
				<elementSpec ident="author" mode="change">
					<classes mode="change">
						<memberOf key="att.naming" mode="delete"/>
						<memberOf key="att.datable" mode="delete"/>
					</classes>
					<attList>
						<attDef ident="xml:id" mode="delete"/>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:lang" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="rend" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
						<attDef ident="calendar" mode="delete"/>
					</attList>
				</elementSpec>
				<elementSpec ident="availability" mode="change">
					<attList>
						<attDef ident="xml:id" mode="delete"/>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="rend" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
					</attList>
				</elementSpec>
				<elementSpec ident="bibl" mode="change">
					<attList>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:lang" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="rend" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
						<attDef ident="type" mode="delete"/>
						<attDef ident="subtype" mode="delete"/>
						<attDef ident="key" mode="delete"/>
					</attList>
				</elementSpec>
				<elementSpec ident="biblScope" mode="change">
					<attList>
						<attDef ident="xml:id" mode="delete"/>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:lang" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="rend" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
					</attList>
				</elementSpec>
				<elementSpec ident="body" mode="change">
					<attList>
						<attDef ident="xml:id" mode="delete"/>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:lang" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="rend" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
					</attList>
				</elementSpec>
				<elementSpec ident="byline" mode="change">
					<attList>
						<attDef ident="xml:id" mode="delete"/>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:lang" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
						<attDef ident="rend" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="center"/>
								<valItem mode="add" ident="left"/>
								<valItem mode="add" ident="right"/>
							</valList>
						</attDef>
					</attList>
				</elementSpec>
				<elementSpec ident="c" mode="change">
					<classes mode="change">
						<memberOf key="att.fragmentable" mode="delete"/>
						<memberOf key="att.typed" mode="delete"/>
					</classes>
					<attList>
						<attDef ident="xml:id" mode="delete"/>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:lang" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="rend" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
						<attDef ident="part" mode="delete"/>
						<attDef ident="function" mode="change" usage="req">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="addForHyphenation">
									<desc versionDate="2024-09-30" xml:lang="en">add the
										character(s) if the word is hyphenated</desc>
								</valItem>
								<valItem mode="add" ident="removeForHyphenation">
									<desc versionDate="2024-09-30" xml:lang="en">remove the
										character(s) if the word is hyphenated</desc>
								</valItem>
							</valList>
						</attDef>
					</attList>
				</elementSpec>
				<elementSpec ident="cell" mode="change">
					<attList>
						<attDef ident="n" mode="delete"/>
						<attDef ident="xml:base" mode="delete"/>
						<attDef ident="xml:space" mode="delete"/>
						<attDef ident="facs" mode="delete"/>
						<attDef ident="cert" mode="delete"/>
						<attDef ident="resp" mode="delete"/>
						<attDef ident="source" mode="delete"/>
						<attDef ident="rend" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="bold"/>
								<valItem mode="add" ident="botBorder"/>
								<valItem mode="add" ident="center"/>
								<valItem mode="add" ident="rightBorder"/>
								<valItem mode="add" ident="verticalCenter"/>
							</valList>
						</attDef>
					</attList>
				</elementSpec>
