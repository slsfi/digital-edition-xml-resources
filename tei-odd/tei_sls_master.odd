								<valItem mode="add" ident="violet-ink"/>
								<valItem mode="add" ident="print"/>
								<valItem mode="add" ident="stamp"/>
								<valItem mode="add" ident="typescript"/>
							</valList>
						</attDef>
						<attDef ident="scribe" mode="delete"/>
						<attDef ident="scribeRef" mode="delete"/>
						<attDef ident="script" mode="delete"/>
						<attDef ident="scriptRef" mode="delete"/>
						<attDef ident="scope" mode="delete"/>
					</attList>
				</classSpec>
				<classSpec ident="att.media" type="atts" mode="change">
					<attList>
						<attDef ident="scale" mode="delete"/>
					</attList>
				</classSpec>
				<classSpec ident="att.milestoneUnit" type="atts" mode="change">
					<attList>
						<attDef ident="unit" mode="change" usage="req">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="item"/>
								<valItem mode="add" ident="part"/>
								<valItem mode="change" ident="section"/>
								<valItem mode="delete" ident="page"/>
								<valItem mode="delete" ident="column"/>
								<valItem mode="delete" ident="line"/>
								<valItem mode="delete" ident="book"/>
								<valItem mode="delete" ident="poem"/>
								<valItem mode="delete" ident="canto"/>
								<valItem mode="delete" ident="speaker"/>
								<valItem mode="delete" ident="stanza"/>
								<valItem mode="delete" ident="act"/>
								<valItem mode="delete" ident="scene"/>
								<valItem mode="delete" ident="absent"/>
								<valItem mode="delete" ident="unnumbered"/>
							</valList>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.naming" type="atts" mode="change">
					<attList>
						<attDef ident="role" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="fictional"/>
							</valList>
						</attDef>
						<attDef ident="nymRef" mode="delete"/>
					</attList>
				</classSpec>
				<classSpec ident="att.placement" type="atts" mode="change">
					<attList>
						<attDef ident="place" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="delete" ident="above"/>
								<valItem mode="delete" ident="below"/>
								<valItem mode="delete" ident="bottom"/>
								<valItem mode="delete" ident="end"/>
								<valItem mode="delete" ident="inline"/>
								<valItem mode="delete" ident="inspace"/>
								<valItem mode="delete" ident="left"/>
								<valItem mode="delete" ident="margin"/>
								<valItem mode="delete" ident="opposite"/>
								<valItem mode="delete" ident="overleaf"/>
								<valItem mode="delete" ident="right"/>
								<valItem mode="delete" ident="top"/>
							</valList>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.pointing" type="atts" mode="change">
					<attList>
						<attDef ident="targetLang" mode="delete"/>
						<attDef ident="evaluate" mode="delete"/>
					</attList>
				</classSpec>
				<classSpec ident="att.segLike" type="atts" mode="change">
					<attList>
						<attDef ident="function" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="addForHyphenation">
									<desc versionDate="2024-09-30" xml:lang="en">add the
										character(s) if the word is hyphenated</desc>
								</valItem>
								<valItem mode="add" ident="removeForHyphenation">
									<desc versionDate="2024-09-30" xml:lang="en">remove the
										character(s) if the word is hyphenated</desc>
								</valItem>
							</valList>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.textCritical" type="atts" mode="change">
					<attList>
						<attDef ident="type" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="empty"/>
								<valItem mode="delete" ident="substantive"/>
								<valItem mode="delete" ident="orthographic"/>
							</valList>
						</attDef>
						<attDef ident="cause" mode="delete"/>
						<attDef ident="varSeq" mode="delete"/>
						<attDef ident="require" mode="delete"/>
					</attList>
				</classSpec>
				<classSpec ident="att.typed" type="atts" mode="change">
					<attList>
						<attDef ident="type" mode="change">
							<valList type="closed" mode="change"/>
						</attDef>
						<attDef ident="subtype" mode="change">
							<valList type="closed" mode="change"/>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.witnessed" type="atts" mode="change">
					<attList>
						<attDef ident="wit" mode="change">
							<desc versionDate="2024-09-30" xml:lang="en">contains the names of the
								witnesses which attest to a given reading.</desc>
						</attDef>
					</attList>
				</classSpec>
			</schemaSpec>
		</body>
	</text>
</TEI>
