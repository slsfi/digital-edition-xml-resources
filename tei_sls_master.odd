				<classSpec ident="att.breaking" type="atts" mode="change">
					<attList>
						<attDef ident="break" mode="change" usage="opt">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="line">
									<desc versionDate="2024-09-30" xml:lang="en">the line break
										occurs between words</desc>
								</valItem>
								<valItem mode="add" ident="word">
									<desc versionDate="2024-09-30" xml:lang="en">the line break
										occurs in the middle of a word, which is hyphenated</desc>
								</valItem>
								<valItem mode="delete" ident="yes"/>
								<valItem mode="delete" ident="no"/>
								<valItem mode="delete" ident="maybe"/>
							</valList>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.canonical" type="atts" mode="change">
					<attList>
						<attDef ident="ref" mode="delete"/>
					</attList>
				</classSpec>
				<classSpec ident="att.dimensions" type="atts" mode="change">
					<attList>
						<attDef ident="unit" mode="change">
							<valList type="closed" mode="change">
								<valItem mode="add" ident="chars">
									<desc versionDate="2024-09-30" xml:lang="en">characters of
										text</desc>
								</valItem>
								<valItem mode="add" ident="lines">
									<desc versionDate="2024-09-30" xml:lang="en">lines of
										text</desc>
								</valItem>
								<valItem mode="add" ident="words">
									<desc versionDate="2024-09-30" xml:lang="en">words of
										text</desc>
								</valItem>
								<valItem mode="delete" ident="cm"/>
								<valItem mode="delete" ident="mm"/>
								<valItem mode="delete" ident="in"/>
								<valItem mode="delete" ident="line"/>
								<valItem mode="delete" ident="char"/>
							</valList>
						</attDef>
						<attDef ident="extent" mode="delete"/>
						<attDef ident="precision" mode="delete"/>
						<attDef ident="scope" mode="delete"/>
					</attList>
				</classSpec>
				<classSpec ident="att.fragmentable" type="atts" mode="change">
					<attList>
						<attDef ident="part" mode="change">
							<valList mode="change">
								<valItem mode="change" ident="M">
									<desc versionDate="2024-09-30" xml:lang="en">this is a medial
										part of a fragmented element if there are three fragments,
										or the second fragment if there are four fragments</desc>
								</valItem>
								<valItem mode="change" ident="F">
									<desc versionDate="2024-09-30" xml:lang="en">this is the final
										part of a fragmented element if there are three fragments,
										or the second to last part if there are four
										fragments</desc>
								</valItem>
								<valItem mode="add" ident="F2">
									<desc versionDate="2024-09-30" xml:lang="en">only used if there
										are four fragments, in that case this is the final part of
										the fragmented element</desc>
								</valItem>
								<valItem mode="delete" ident="Y"/>
								<valItem mode="delete" ident="N"/>
							</valList>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.global" type="atts" mode="change">
					<attList>
						<attDef ident="xml:lang" mode="change">
							<valList type="semi" mode="change">
								<valItem mode="add" ident="sv">
									<desc versionDate="2024-09-30" xml:lang="en">Swedish</desc>
								</valItem>
								<valItem mode="add" ident="fi">
									<desc versionDate="2024-09-30" xml:lang="en">Finnish</desc>
								</valItem>
								<valItem mode="add" ident="en">
									<desc versionDate="2024-09-30" xml:lang="en">English</desc>
								</valItem>
								<valItem mode="add" ident="fr">
									<desc versionDate="2024-09-30" xml:lang="en">French</desc>
								</valItem>
								<valItem mode="add" ident="de">
									<desc versionDate="2024-09-30" xml:lang="en">German</desc>
								</valItem>
							</valList>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.global.facs" type="atts" mode="change">
					<attList>
						<attDef ident="facs" mode="change">
							<desc versionDate="2024-09-30" xml:lang="en">filename of image depicting
								the current page.</desc>
						</attDef>
					</attList>
				</classSpec>
				<classSpec ident="att.global.rendition" type="atts" mode="change">
